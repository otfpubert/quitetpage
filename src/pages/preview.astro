---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import HeroSplit from '../components/hero/HeroSplit.astro';
import HeroCentered from '../components/hero/HeroCentered.astro';
import HeroFullImage from '../components/hero/HeroFullImage.astro';
import Services from '../components/Services.astro';
import HowWeWork from '../components/HowWeWork.astro';
import WhyUs from '../components/WhyUs.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { heroById } from '../config/heroVariants';
import { themeById, DEFAULT_THEME } from '../config/themes';

const url = new URL(Astro.request.url);
const heroParam = url.searchParams.get('hero');
const themeParam = url.searchParams.get('theme');

const hero = heroById(heroParam);
const theme = themeById(themeParam);
const themeId = theme?.id ?? DEFAULT_THEME;
---

<Layout theme={themeId}>
  <Navbar />
  <main>
    {hero.id === 'split' && <HeroSplit />}
    {hero.id === 'centered' && <HeroCentered />}
    {hero.id === 'full-image' && <HeroFullImage />}
    <Services />
    <HowWeWork />
    <WhyUs />
    <Testimonials />
    <FAQ />
    <Contact />
  </main>
  <Footer />
</Layout>

<script>
  // Listen for live theme/hero updates from the parent window when embedded as iframe
  window.addEventListener('message', (event) => {
    if (!event.data || typeof event.data !== 'object') return;
    const { type, theme, hero } = event.data as { type?: string; theme?: string; hero?: string };
    if (type !== 'showcase:update') return;

    if (theme) {
      document.documentElement.setAttribute('data-theme', theme);
    }
    if (hero) {
      // Hero variant requires full reload because sections are SSR-rendered
      const url = new URL(window.location.href);
      url.searchParams.set('hero', hero);
      if (theme) url.searchParams.set('theme', theme);
      window.location.replace(url.toString());
    }
  });
</script>
