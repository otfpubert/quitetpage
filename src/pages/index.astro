---
import Layout from '../layouts/Layout.astro';
import { themes, DEFAULT_THEME } from '../config/themes';
import { heroVariants, DEFAULT_HERO } from '../config/heroVariants';

const features = [
  {
    title: 'Hero z wariantami',
    description: '3 układy sekcji startowej do wyboru: split, centered, full-image. Przełączane jednym kliknięciem.',
    icon: 'M4 6h16M4 12h8m-8 6h16',
  },
  {
    title: 'Sekcja usług',
    description: 'Siatka 6 kart: obsługa kadrowa, płacowa, outsourcing HR, BHP, doradztwo prawne, raporty.',
    icon: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2H7a2 2 0 00-2 2v2',
  },
  {
    title: 'Jak działamy — stepper',
    description: 'Wizualny timeline procesu współpracy: kontakt → analiza → oferta → wdrożenie → obsługa.',
    icon: 'M13 5l7 7-7 7M5 5l7 7-7 7',
  },
  {
    title: 'Dlaczego my',
    description: 'Wyróżniki firmy w formie ikon: terminowość, dedykowany opiekun, bezpieczeństwo danych, doświadczenie.',
    icon: 'M5 13l4 4L19 7',
  },
  {
    title: 'Opinie klientów',
    description: 'Karuzela/siatka testimoniali. Opcjonalnie integracja z opiniami Google.',
    icon: 'M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z',
  },
  {
    title: 'FAQ',
    description: 'Accordion z najczęściej zadawanymi pytaniami. Smooth expand/collapse.',
    icon: 'M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093M12 17h.01',
  },
  {
    title: 'Formularz kontaktowy',
    description: 'Pola: imię, email, telefon, firma, temat, wiadomość. Walidacja + zgoda RODO + hCaptcha.',
    icon: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
  },
  {
    title: 'RODO & polityka prywatności',
    description: 'Banner cookies, polityka prywatności, regulamin, klauzula zgody przy formularzu.',
    icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  },
  {
    title: 'Responsywność',
    description: 'Mobile / tablet / desktop — sprawdzone breakpointy, dotykowe menu, czytelne na każdym ekranie.',
    icon: 'M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z',
  },
  {
    title: 'SEO & wydajność',
    description: 'Meta tagi, sitemap, schema.org, lazy loading obrazów. Cel: Lighthouse 95+.',
    icon: 'M13 7h8m0 0v8m0-8l-8 8-4-4-6 6',
  },
  {
    title: 'Motywy kolorystyczne',
    description: '5 gotowych motywów — jedno kliknięcie zmienia kolory w całym serwisie.',
    icon: 'M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01',
  },
  {
    title: 'Edycja treści w Markdown',
    description: 'Każda sekcja edytowalna przez plik .md — osoba nietechniczna bez problemu zmieni treści.',
    icon: 'M4 6h16M4 10h16M4 14h16M4 18h16',
  },
];

const base = import.meta.env.BASE_URL;
---

<Layout title="StronaHR — Wybierz wygląd" theme={DEFAULT_THEME} bodyClass="font-sans text-gray-800 antialiased bg-slate-50">
  <header class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <span class="text-xl font-bold text-slate-900">
        Strona<span class="text-primary">HR</span>
        <span class="ml-2 text-xs font-medium text-slate-500 uppercase tracking-wider">showcase</span>
      </span>
      <a id="preview-link-top" href={`${base}preview`} target="_blank" rel="noopener" class="text-sm font-semibold text-primary hover:text-primary-dark transition-colors">
        Otwórz pełny podgląd →
      </a>
    </div>
  </header>

  <!-- HERO LANDINGU -->
  <section class="py-20 lg:py-28 bg-gradient-to-br from-slate-900 via-slate-800 to-primary-dark text-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-block bg-white/10 backdrop-blur-sm text-white/90 text-sm font-medium px-4 py-1.5 rounded-full mb-6">
        Krok przed wdrożeniem
      </div>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-tight mb-6">
        Wybierz wygląd swojej strony
      </h1>
      <p class="text-lg sm:text-xl text-white/80 max-w-2xl mx-auto leading-relaxed">
        Poniżej znajdziesz listę planowanych funkcji, 3 warianty sekcji głównej (Hero) oraz 5 motywów kolorystycznych. Wybór zobaczysz na żywo w podglądzie poniżej.
      </p>
    </div>
  </section>

  <!-- PLANOWANE FUNKCJE -->
  <section class="py-20 lg:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-12">
        <div class="text-sm font-semibold text-primary uppercase tracking-wider mb-3">01 · Zakres</div>
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">Planowane funkcje</h2>
        <p class="text-lg text-slate-600">
          Tak wygląda zakres prac po mojej stronie. Pełny plan wraz z uzasadnieniem stacku, wymaganiami prawnymi i etapami realizacji znajdziesz w pliku <code class="text-sm bg-slate-100 px-1.5 py-0.5 rounded">PLAN.md</code>.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {features.map((f) => (
          <div class="p-6 rounded-2xl border border-slate-200 bg-white hover:border-primary/30 hover:shadow-md transition-all">
            <div class="bg-primary/10 text-primary w-12 h-12 rounded-xl flex items-center justify-center mb-4">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={f.icon} />
              </svg>
            </div>
            <h3 class="font-bold text-slate-900 mb-2">{f.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{f.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WYBÓR WARIANTU HERO -->
  <section class="py-20 lg:py-24 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-12">
        <div class="text-sm font-semibold text-primary uppercase tracking-wider mb-3">02 · Układ</div>
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">Wariant sekcji głównej (Hero)</h2>
        <p class="text-lg text-slate-600">
          To pierwsze, co zobaczy odwiedzający. Kliknij wariant, żeby zobaczyć go w podglądzie poniżej.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        {heroVariants.map((h) => (
          <button
            type="button"
            class="hero-option group text-left p-6 rounded-2xl border-2 bg-white hover:shadow-lg transition-all data-[active=true]:border-primary data-[active=true]:shadow-lg data-[active=false]:border-slate-200"
            data-hero={h.id}
            data-active={h.id === DEFAULT_HERO}
          >
            <div class="aspect-[16/10] rounded-lg mb-4 bg-gradient-to-br from-primary-dark to-primary overflow-hidden relative">
              {h.id === 'split' && (
                <div class="absolute inset-0 p-4 flex items-center gap-3">
                  <div class="flex-1 space-y-2">
                    <div class="h-2 bg-white/60 rounded w-3/4"></div>
                    <div class="h-3 bg-accent rounded w-1/2"></div>
                    <div class="h-1.5 bg-white/30 rounded w-full"></div>
                    <div class="h-1.5 bg-white/30 rounded w-4/5"></div>
                    <div class="h-4 bg-accent rounded w-1/3 mt-2"></div>
                  </div>
                  <div class="flex-1 bg-white/20 rounded h-full"></div>
                </div>
              )}
              {h.id === 'centered' && (
                <div class="absolute inset-0 p-4 flex flex-col items-center justify-center text-center space-y-2">
                  <div class="h-1.5 bg-white/40 rounded w-1/4"></div>
                  <div class="h-3 bg-white/80 rounded w-3/4"></div>
                  <div class="h-3 bg-accent rounded w-1/2"></div>
                  <div class="h-1.5 bg-white/30 rounded w-2/3 mt-1"></div>
                  <div class="h-4 bg-accent rounded w-1/4 mt-2"></div>
                </div>
              )}
              {h.id === 'full-image' && (
                <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('https://images.unsplash.com/photo-1497366216548-37526070297c?w=400&h=250&fit=crop')">
                  <div class="absolute inset-0 bg-gradient-to-r from-primary-dark/95 to-primary-dark/20"></div>
                  <div class="absolute inset-0 p-4 flex flex-col justify-center">
                    <div class="space-y-2 max-w-[60%]">
                      <div class="h-2 bg-accent/80 rounded w-1/2"></div>
                      <div class="h-3 bg-white rounded w-full"></div>
                      <div class="h-3 bg-accent rounded w-3/4"></div>
                      <div class="h-1.5 bg-white/40 rounded w-full mt-1"></div>
                      <div class="h-4 bg-accent rounded w-1/3 mt-2"></div>
                    </div>
                  </div>
                </div>
              )}
            </div>
            <div class="flex items-center justify-between mb-2">
              <h3 class="font-bold text-slate-900">{h.name}</h3>
              <span class="text-xs font-semibold text-primary opacity-0 group-data-[active=true]:opacity-100 transition-opacity">✓ wybrany</span>
            </div>
            <p class="text-sm text-slate-600 leading-relaxed">{h.description}</p>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- WYBÓR MOTYWU -->
  <section class="py-20 lg:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-12">
        <div class="text-sm font-semibold text-primary uppercase tracking-wider mb-3">03 · Kolorystyka</div>
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">Motyw kolorystyczny</h2>
        <p class="text-lg text-slate-600">
          Zmiana jest natychmiastowa — zarówno ten landing, jak i podgląd poniżej zmienią kolory.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-4">
        {themes.map((t) => (
          <button
            type="button"
            class="theme-option group text-left p-4 rounded-2xl border-2 bg-white hover:shadow-lg transition-all data-[active=true]:border-primary data-[active=true]:shadow-lg data-[active=false]:border-slate-200"
            data-theme={t.id}
            data-active={t.id === DEFAULT_THEME}
          >
            <div class="flex gap-1.5 mb-3 h-16 rounded-lg overflow-hidden">
              <div class="flex-1" style={`background: ${t.primary}`}></div>
              <div class="flex-1" style={`background: ${t.secondary}`}></div>
              <div class="flex-1" style={`background: ${t.accent}`}></div>
            </div>
            <div class="flex items-center justify-between mb-1">
              <h3 class="font-bold text-slate-900 text-sm">{t.name}</h3>
              <span class="text-xs text-primary opacity-0 group-data-[active=true]:opacity-100 transition-opacity">✓</span>
            </div>
            <p class="text-xs text-slate-500 leading-relaxed">{t.description}</p>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- LIVE PREVIEW -->
  <section class="py-20 lg:py-24 bg-slate-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-8">
        <div>
          <div class="text-sm font-semibold text-accent uppercase tracking-wider mb-3">04 · Podgląd na żywo</div>
          <h2 class="text-3xl sm:text-4xl font-bold text-white mb-2">Zobacz, jak to wygląda</h2>
          <p class="text-slate-400">Zmiany powyżej odzwierciedlają się tutaj natychmiast.</p>
        </div>
        <div class="flex gap-2 bg-slate-800 p-1 rounded-lg self-start">
          <button type="button" class="viewport-btn px-3 py-1.5 rounded-md text-sm font-medium text-white data-[active=true]:bg-slate-700 data-[active=false]:text-slate-400 data-[active=false]:hover:text-white transition-colors" data-width="desktop" data-active="true">Desktop</button>
          <button type="button" class="viewport-btn px-3 py-1.5 rounded-md text-sm font-medium text-white data-[active=true]:bg-slate-700 data-[active=false]:text-slate-400 data-[active=false]:hover:text-white transition-colors" data-width="tablet" data-active="false">Tablet</button>
          <button type="button" class="viewport-btn px-3 py-1.5 rounded-md text-sm font-medium text-white data-[active=true]:bg-slate-700 data-[active=false]:text-slate-400 data-[active=false]:hover:text-white transition-colors" data-width="mobile" data-active="false">Mobile</button>
        </div>
      </div>

      <div id="preview-shell" class="mx-auto bg-white rounded-xl overflow-hidden shadow-2xl transition-[max-width] duration-300" style="max-width: 100%;">
        <div class="bg-slate-100 border-b border-slate-200 px-4 py-2.5 flex items-center gap-2">
          <div class="flex gap-1.5">
            <span class="w-3 h-3 rounded-full bg-red-400"></span>
            <span class="w-3 h-3 rounded-full bg-yellow-400"></span>
            <span class="w-3 h-3 rounded-full bg-green-400"></span>
          </div>
          <div class="flex-1 text-center text-xs text-slate-500 truncate" id="preview-url">preview</div>
        </div>
        <iframe
          id="preview-frame"
          src={`${base}preview?hero=${DEFAULT_HERO}&theme=${DEFAULT_THEME}`}
          title="Podgląd strony"
          class="w-full border-0"
          style="height: 800px;"
          loading="lazy"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- PODSUMOWANIE -->
  <section class="py-20 lg:py-24 bg-gradient-to-br from-primary-dark via-primary to-primary-light text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="text-sm font-semibold text-accent uppercase tracking-wider mb-3">05 · Twój wybór</div>
      <h2 class="text-3xl sm:text-4xl font-bold mb-8">Wybrany layout</h2>

      <div class="inline-flex flex-col sm:flex-row gap-6 items-center bg-white/10 backdrop-blur-sm border border-white/20 rounded-2xl p-8 mb-8">
        <div class="text-left">
          <div class="text-sm text-white/60 uppercase tracking-wider">Hero</div>
          <div id="summary-hero" class="text-2xl font-bold text-accent">—</div>
        </div>
        <div class="hidden sm:block h-12 w-px bg-white/20"></div>
        <div class="text-left">
          <div class="text-sm text-white/60 uppercase tracking-wider">Motyw</div>
          <div id="summary-theme" class="text-2xl font-bold text-accent">—</div>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a id="preview-link-bottom" href={`${base}preview`} target="_blank" rel="noopener" class="inline-flex items-center justify-center bg-accent hover:bg-accent-light text-primary-dark font-bold px-8 py-4 rounded-xl transition-all hover:scale-105">
          Otwórz pełny podgląd w nowej karcie
          <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>
        <button
          id="copy-choice"
          type="button"
          class="inline-flex items-center justify-center border-2 border-white/30 hover:border-white/60 text-white font-semibold px-8 py-4 rounded-xl transition-all hover:bg-white/10"
        >
          Skopiuj wybór do schowka
        </button>
      </div>
    </div>
  </section>

  <footer class="py-8 bg-slate-950 text-center text-sm text-slate-500">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p>StronaHR · Showcase · Zobacz też <a href="https://github.com" class="text-slate-400 hover:text-white underline">kod na GitHubie</a></p>
    </div>
  </footer>
</Layout>

<script>
  import { themes, DEFAULT_THEME, type ThemeId } from '../config/themes';
  import { heroVariants, DEFAULT_HERO, type HeroId } from '../config/heroVariants';

  const state: { hero: HeroId; theme: ThemeId } = {
    hero: DEFAULT_HERO,
    theme: DEFAULT_THEME,
  };

  const base = import.meta.env.BASE_URL;
  const frame = document.getElementById('preview-frame') as HTMLIFrameElement | null;
  const previewUrlEl = document.getElementById('preview-url');
  const summaryHero = document.getElementById('summary-hero');
  const summaryTheme = document.getElementById('summary-theme');
  const linkTop = document.getElementById('preview-link-top') as HTMLAnchorElement | null;
  const linkBottom = document.getElementById('preview-link-bottom') as HTMLAnchorElement | null;

  const buildPreviewUrl = () => `${base}preview?hero=${state.hero}&theme=${state.theme}`;

  const render = (reloadFrame = false) => {
    document.documentElement.setAttribute('data-theme', state.theme);

    document.querySelectorAll<HTMLButtonElement>('.hero-option').forEach((btn) => {
      btn.dataset.active = String(btn.dataset.hero === state.hero);
    });
    document.querySelectorAll<HTMLButtonElement>('.theme-option').forEach((btn) => {
      btn.dataset.active = String(btn.dataset.theme === state.theme);
    });

    const heroName = heroVariants.find((h) => h.id === state.hero)?.name ?? '—';
    const themeName = themes.find((t) => t.id === state.theme)?.name ?? '—';
    if (summaryHero) summaryHero.textContent = heroName;
    if (summaryTheme) summaryTheme.textContent = themeName;

    const url = buildPreviewUrl();
    if (linkTop) linkTop.href = url;
    if (linkBottom) linkBottom.href = url;
    if (previewUrlEl) previewUrlEl.textContent = url;

    if (frame) {
      if (reloadFrame) {
        frame.src = url;
      } else {
        frame.contentWindow?.postMessage(
          { type: 'showcase:update', theme: state.theme },
          '*',
        );
      }
    }
  };

  document.querySelectorAll<HTMLButtonElement>('.hero-option').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.hero as HeroId | undefined;
      if (!id || id === state.hero) return;
      state.hero = id;
      render(true);
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.theme-option').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.theme as ThemeId | undefined;
      if (!id || id === state.theme) return;
      state.theme = id;
      render(false);
    });
  });

  const shell = document.getElementById('preview-shell') as HTMLElement | null;
  const viewportMap: Record<string, string> = {
    desktop: '100%',
    tablet: '820px',
    mobile: '400px',
  };
  document.querySelectorAll<HTMLButtonElement>('.viewport-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const width = btn.dataset.width ?? 'desktop';
      if (shell) shell.style.maxWidth = viewportMap[width] ?? '100%';
      document.querySelectorAll<HTMLButtonElement>('.viewport-btn').forEach((b) => {
        b.dataset.active = String(b === btn);
      });
    });
  });

  document.getElementById('copy-choice')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    const heroName = heroVariants.find((h) => h.id === state.hero)?.name ?? state.hero;
    const themeName = themes.find((t) => t.id === state.theme)?.name ?? state.theme;
    const text = `Wybór wyglądu strony:\n- Hero: ${heroName} (${state.hero})\n- Motyw: ${themeName} (${state.theme})\n- Podgląd: ${window.location.origin}${buildPreviewUrl()}`;
    try {
      await navigator.clipboard.writeText(text);
      const original = btn.textContent;
      btn.textContent = 'Skopiowano ✓';
      setTimeout(() => { btn.textContent = original; }, 2000);
    } catch {
      alert(text);
    }
  });

  render(false);
</script>
