---
const currentYear = new Date().getFullYear();
---

<footer class="bg-primary-dark text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Main footer -->
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-10 py-16">
      <!-- Brand -->
      <div class="lg:col-span-1">
        <a href="/" class="text-2xl font-bold">
          Strona<span class="text-accent">HR</span>
        </a>
        <p class="text-white/60 text-sm mt-4 leading-relaxed">
          Profesjonalna obsługa kadrowo-płacowa dla firm, które cenią czas i bezpieczeństwo.
        </p>
      </div>

      <!-- Quick links -->
      <div>
        <h4 class="font-semibold text-white mb-4">Usługi</h4>
        <ul class="space-y-2.5 text-sm text-white/60">
          <li><a href="#uslugi" class="hover:text-white transition-colors">Obsługa kadrowa</a></li>
          <li><a href="#uslugi" class="hover:text-white transition-colors">Obsługa płacowa</a></li>
          <li><a href="#uslugi" class="hover:text-white transition-colors">Outsourcing HR</a></li>
          <li><a href="#uslugi" class="hover:text-white transition-colors">BHP i szkolenia</a></li>
          <li><a href="#uslugi" class="hover:text-white transition-colors">Doradztwo prawne</a></li>
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h4 class="font-semibold text-white mb-4">Firma</h4>
        <ul class="space-y-2.5 text-sm text-white/60">
          <li><a href="#jak-dzialamy" class="hover:text-white transition-colors">Jak działamy</a></li>
          <li><a href="#dlaczego-my" class="hover:text-white transition-colors">Dlaczego my</a></li>
          <li><a href="#opinie" class="hover:text-white transition-colors">Opinie klientów</a></li>
          <li><a href="#faq" class="hover:text-white transition-colors">FAQ</a></li>
          <li><a href="#kontakt" class="hover:text-white transition-colors">Kontakt</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="font-semibold text-white mb-4">Kontakt</h4>
        <ul class="space-y-2.5 text-sm text-white/60">
          <li>ul. Przykładowa 42</li>
          <li>00-001 Warszawa</li>
          <li class="pt-2">
            <a href="tel:+48123456789" class="hover:text-white transition-colors">+48 123 456 789</a>
          </li>
          <li>
            <a href="mailto:kontakt@stronahr.pl" class="hover:text-white transition-colors">kontakt@stronahr.pl</a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-white/10 py-6 flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="text-sm text-white/40">
        &copy; {currentYear} StronaHR Sp. z o.o. | NIP: 000-000-00-00 | REGON: 000000000
      </div>
      <div class="flex gap-6 text-sm text-white/40">
        <a href="/polityka-prywatnosci" class="hover:text-white transition-colors">Polityka prywatności</a>
        <a href="/regulamin" class="hover:text-white transition-colors">Regulamin</a>
      </div>
    </div>
  </div>
</footer>
