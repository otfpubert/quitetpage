---
const testimonials = [
  {
    name: 'Anna Kowalska',
    role: 'Prezes Zarządu, TechCorp Sp. z o.o.',
    text: 'Współpraca z StronaHR to najlepsza decyzja kadrowa, jaką podjęliśmy. Profesjonalizm, terminowość i pełne zrozumienie naszych potrzeb. Po 3 latach nie wyobrażam sobie powrotu do własnego działu HR.',
    rating: 5,
  },
  {
    name: 'Marek Nowak',
    role: 'Dyrektor Finansowy, BudMar S.A.',
    text: 'Szukaliśmy firmy, która odciąży nasz dział księgowy od spraw kadrowych. StronaHR przejęła wszystko płynnie, bez żadnych przestojów. Oszczędzamy około 40% w porównaniu z utrzymaniem własnego zespołu.',
    rating: 5,
  },
  {
    name: 'Katarzyna Wiśniewska',
    role: 'Właścicielka, Gastro Group',
    text: 'Mamy 150 pracowników w gastronomii — ciągła rotacja, umowy zlecenie, różne stawki. StronaHR ogarnia to wszystko bezbłędnie. Dedykowana opiekunka zna naszą firmę lepiej niż my sami.',
    rating: 5,
  },
];

const stars = (count: number) => '★'.repeat(count) + '☆'.repeat(5 - count);
---

<section id="opinie" class="py-20 lg:py-28 bg-surface">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-block bg-accent/10 text-amber-700 text-sm font-semibold px-4 py-1.5 rounded-full mb-4">
        Opinie klientów
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
        Co mówią o nas klienci
      </h2>
      <p class="text-lg text-gray-600">
        Najlepszą rekomendacją jest zadowolenie naszych klientów.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {testimonials.map(t => (
        <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-sm hover:shadow-md transition-shadow duration-300">
          <div class="text-accent text-xl mb-4 tracking-wider">{stars(t.rating)}</div>
          <p class="text-gray-600 leading-relaxed mb-6 italic">"{t.text}"</p>
          <div class="flex items-center gap-3 pt-4 border-t border-gray-100">
            <div class="w-10 h-10 bg-primary/10 text-primary rounded-full flex items-center justify-center font-bold text-sm">
              {t.name.split(' ').map(n => n[0]).join('')}
            </div>
            <div>
              <div class="font-semibold text-gray-900 text-sm">{t.name}</div>
              <div class="text-xs text-gray-500">{t.role}</div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
