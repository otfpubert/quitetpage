---
const features = [
  {
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
    title: 'Gwarancja terminowości',
    description: 'Wynagrodzenia, deklaracje ZUS i PIT — zawsze na czas. Zero opóźnień, zero kar.',
  },
  {
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>`,
    title: 'Dedykowany opiekun',
    description: 'Jeden stały specjalista, który zna Twoją firmę. Nie musisz za każdym razem tłumaczyć wszystkiego od nowa.',
  },
  {
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>`,
    title: 'Bezpieczeństwo danych',
    description: 'Przetwarzamy dane zgodnie z RODO. Szyfrowanie, kontrola dostępu, regularne audyty bezpieczeństwa.',
  },
  {
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>`,
    title: '15 lat doświadczenia',
    description: 'Obsłużyliśmy setki firm z różnych branż. Znamy specyfikę każdej z nich.',
  },
  {
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>`,
    title: 'Oszczędność kosztów',
    description: 'Outsourcing kadr jest tańszy niż własny dział HR. Płacisz za usługę, nie za etaty, biuro i systemy.',
  },
  {
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/></svg>`,
    title: 'Zawsze zgodnie z prawem',
    description: 'Śledzimy zmiany w przepisach na bieżąco. Twoja firma jest zawsze w pełni zgodna z obowiązującym prawem pracy.',
  },
];
---

<section id="dlaczego-my" class="py-20 lg:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <!-- Left: image + stats -->
      <div>
        <img
          src="https://images.unsplash.com/photo-1552664730-d307ca884978?w=600&h=400&fit=crop"
          alt="Zespół przy pracy"
          class="rounded-2xl w-full h-80 object-cover shadow-lg mb-8"
          loading="lazy"
        />
        <div class="grid grid-cols-3 gap-4">
          <div class="bg-primary/5 rounded-xl p-4 text-center">
            <div class="text-2xl font-bold text-primary">200+</div>
            <div class="text-xs text-gray-500 mt-1">Klientów</div>
          </div>
          <div class="bg-secondary/5 rounded-xl p-4 text-center">
            <div class="text-2xl font-bold text-secondary">99.8%</div>
            <div class="text-xs text-gray-500 mt-1">Terminowość</div>
          </div>
          <div class="bg-accent/10 rounded-xl p-4 text-center">
            <div class="text-2xl font-bold text-amber-600">4.9/5</div>
            <div class="text-xs text-gray-500 mt-1">Ocena klientów</div>
          </div>
        </div>
      </div>

      <!-- Right: features -->
      <div>
        <div class="inline-block bg-secondary/10 text-secondary text-sm font-semibold px-4 py-1.5 rounded-full mb-4">
          Dlaczego my
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-6">
          Partnerstwo, nie tylko usługa
        </h2>
        <p class="text-lg text-gray-600 mb-10">
          Nie jesteśmy kolejną firmą outsourcingową. Traktujemy Twój biznes jak swój.
        </p>

        <div class="space-y-6">
          {features.map(feature => (
            <div class="flex gap-4 items-start">
              <div class="flex-shrink-0 w-12 h-12 bg-primary/5 text-primary rounded-xl flex items-center justify-center">
                <Fragment set:html={feature.icon} />
              </div>
              <div>
                <h3 class="font-bold text-gray-900 mb-1">{feature.title}</h3>
                <p class="text-sm text-gray-600">{feature.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
