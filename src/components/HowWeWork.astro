---
const steps = [
  {
    number: '01',
    title: 'Kontakt',
    description: 'Zadzwoń lub napisz do nas. Umówimy się na bezpłatną konsultację i poznamy potrzeby Twojej firmy.',
  },
  {
    number: '02',
    title: 'Analiza potrzeb',
    description: 'Przeanalizujemy strukturę Twojej firmy, liczbę pracowników i zakres potrzebnych usług.',
  },
  {
    number: '03',
    title: 'Indywidualna oferta',
    description: 'Przygotujemy ofertę dopasowaną do Twojej firmy — bez ukrytych kosztów, z jasnym zakresem.',
  },
  {
    number: '04',
    title: 'Wdrożenie',
    description: 'Płynnie przejmujemy obsługę kadrowo-płacową. Zajmujemy się migracją danych i dokumentacji.',
  },
  {
    number: '05',
    title: 'Stała obsługa',
    description: 'Działamy jak Twój zewnętrzny dział HR. Dedykowany opiekun, stały kontakt, comiesięczne raporty.',
  },
];
---

<section id="jak-dzialamy" class="py-20 lg:py-28 bg-surface">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-block bg-primary/10 text-primary text-sm font-semibold px-4 py-1.5 rounded-full mb-4">
        Proces współpracy
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
        Jak zaczynamy współpracę?
      </h2>
      <p class="text-lg text-gray-600">
        Przejście na outsourcing kadr i płac jest prostsze niż myślisz. Cały proces trwa zazwyczaj 2-4 tygodnie.
      </p>
    </div>

    <div class="relative max-w-4xl mx-auto">
      <!-- Vertical line -->
      <div class="absolute left-8 top-0 bottom-0 w-0.5 bg-primary/10 hidden md:block"></div>

      <div class="space-y-8">
        {steps.map((step, i) => (
          <div class="relative flex gap-6 md:gap-10 items-start group">
            <!-- Number circle -->
            <div class="relative z-10 flex-shrink-0 w-16 h-16 bg-primary text-white rounded-2xl flex items-center justify-center font-bold text-lg group-hover:bg-secondary transition-colors duration-300 shadow-lg">
              {step.number}
            </div>
            <!-- Content -->
            <div class="bg-white rounded-2xl p-6 flex-1 border border-gray-100 group-hover:border-secondary/20 group-hover:shadow-md transition-all duration-300">
              <h3 class="text-xl font-bold text-gray-900 mb-2">{step.title}</h3>
              <p class="text-gray-600 leading-relaxed">{step.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
