---
const services = [
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
    title: 'Obsługa kadrowa',
    description: 'Prowadzenie akt osobowych, umowy o pracę, ewidencja czasu pracy, urlopy i zwolnienia. Pełna dokumentacja kadrowa zgodna z przepisami.',
  },
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
    title: 'Obsługa płacowa',
    description: 'Naliczanie wynagrodzeń, listy płac, deklaracje ZUS i PIT, rozliczenia podatkowe. Terminowo i bezbłędnie, co miesiąc.',
  },
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>`,
    title: 'Outsourcing HR',
    description: 'Przejmujemy cały dział HR Twojej firmy. Rekrutacja, onboarding, szkolenia, oceny pracownicze — wszystko pod jednym dachem.',
  },
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`,
    title: 'BHP i szkolenia',
    description: 'Szkolenia wstępne i okresowe BHP, ocena ryzyka zawodowego, dokumentacja powypadkowa. Zadbamy o bezpieczeństwo Twoich pracowników.',
  },
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/></svg>`,
    title: 'Doradztwo prawne',
    description: 'Konsultacje z zakresu prawa pracy, regulaminy wewnętrzne, pomoc przy kontrolach PIP i ZUS. Zawsze na bieżąco z przepisami.',
  },
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>`,
    title: 'Raporty i analizy',
    description: 'Regularne raporty kadrowo-płacowe, analizy kosztów zatrudnienia, zestawienia dla zarządu. Dane, które pomagają podejmować decyzje.',
  },
];
---

<section id="uslugi" class="py-20 lg:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-block bg-secondary/10 text-secondary text-sm font-semibold px-4 py-1.5 rounded-full mb-4">
        Nasze usługi
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
        Kompleksowa obsługa kadrowo-płacowa
      </h2>
      <p class="text-lg text-gray-600">
        Oferujemy pełen zakres usług z obszaru HR, kadr i płac. Dopasujemy zakres współpracy do potrzeb Twojej firmy.
      </p>
    </div>

    <!-- Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {services.map((service, i) => (
        <div class="group p-8 rounded-2xl border border-gray-100 hover:border-secondary/20 bg-white hover:bg-secondary/5 transition-all duration-300 hover:shadow-lg hover:-translate-y-1">
          <div class="bg-secondary/10 text-secondary w-14 h-14 rounded-xl flex items-center justify-center mb-5 group-hover:bg-secondary group-hover:text-white transition-colors duration-300">
            <Fragment set:html={service.icon} />
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">{service.title}</h3>
          <p class="text-gray-600 leading-relaxed">{service.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
