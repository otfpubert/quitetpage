<section id="kontakt" class="py-20 lg:py-28 bg-surface">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-block bg-secondary/10 text-secondary text-sm font-semibold px-4 py-1.5 rounded-full mb-4">
        Kontakt
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
        Porozmawiajmy o Twoich potrzebach
      </h2>
      <p class="text-lg text-gray-600">
        Wypełnij formularz lub skontaktuj się bezpośrednio. Odpowiadamy w ciągu 24 godzin.
      </p>
    </div>

    <div class="grid lg:grid-cols-5 gap-12">
      <!-- Contact info -->
      <div class="lg:col-span-2 space-y-8">
        <div class="bg-white rounded-2xl p-8 border border-gray-100">
          <h3 class="font-bold text-gray-900 text-lg mb-6">Dane kontaktowe</h3>

          <div class="space-y-5">
            <div class="flex gap-4 items-start">
              <div class="w-10 h-10 bg-primary/5 text-primary rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <div>
                <div class="font-semibold text-gray-900 text-sm">Adres</div>
                <div class="text-gray-600 text-sm">ul. Przykładowa 42<br />00-001 Warszawa</div>
              </div>
            </div>

            <div class="flex gap-4 items-start">
              <div class="w-10 h-10 bg-primary/5 text-primary rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </div>
              <div>
                <div class="font-semibold text-gray-900 text-sm">Telefon</div>
                <div class="text-gray-600 text-sm">+48 123 456 789</div>
              </div>
            </div>

            <div class="flex gap-4 items-start">
              <div class="w-10 h-10 bg-primary/5 text-primary rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <div class="font-semibold text-gray-900 text-sm">Email</div>
                <div class="text-gray-600 text-sm">kontakt@stronahr.pl</div>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-2xl p-8 border border-gray-100">
          <h3 class="font-bold text-gray-900 text-lg mb-3">Dane firmy</h3>
          <div class="text-sm text-gray-600 space-y-1">
            <p>StronaHR Sp. z o.o.</p>
            <p>NIP: 000-000-00-00</p>
            <p>REGON: 000000000</p>
            <p>KRS: 0000000000</p>
          </div>
        </div>
      </div>

      <!-- Form -->
      <div class="lg:col-span-3">
        <form class="bg-white rounded-2xl p-8 border border-gray-100 shadow-sm">
          <div class="grid sm:grid-cols-2 gap-5 mb-5">
            <div>
              <label for="name" class="block text-sm font-medium text-gray-700 mb-1.5">Imię i nazwisko *</label>
              <input type="text" id="name" name="name" required
                class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-secondary focus:ring-2 focus:ring-secondary/20 outline-none transition-all text-sm"
                placeholder="Jan Kowalski" />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-gray-700 mb-1.5">Email *</label>
              <input type="email" id="email" name="email" required
                class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-secondary focus:ring-2 focus:ring-secondary/20 outline-none transition-all text-sm"
                placeholder="jan@firma.pl" />
            </div>
          </div>

          <div class="grid sm:grid-cols-2 gap-5 mb-5">
            <div>
              <label for="phone" class="block text-sm font-medium text-gray-700 mb-1.5">Telefon</label>
              <input type="tel" id="phone" name="phone"
                class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-secondary focus:ring-2 focus:ring-secondary/20 outline-none transition-all text-sm"
                placeholder="+48 123 456 789" />
            </div>
            <div>
              <label for="company" class="block text-sm font-medium text-gray-700 mb-1.5">Firma</label>
              <input type="text" id="company" name="company"
                class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-secondary focus:ring-2 focus:ring-secondary/20 outline-none transition-all text-sm"
                placeholder="Nazwa firmy" />
            </div>
          </div>

          <div class="mb-5">
            <label for="subject" class="block text-sm font-medium text-gray-700 mb-1.5">Temat *</label>
            <select id="subject" name="subject" required
              class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-secondary focus:ring-2 focus:ring-secondary/20 outline-none transition-all text-sm">
              <option value="">Wybierz temat...</option>
              <option value="wycena">Zapytanie o wycenę</option>
              <option value="kadry">Obsługa kadrowa</option>
              <option value="place">Obsługa płacowa</option>
              <option value="outsourcing">Outsourcing HR</option>
              <option value="bhp">BHP i szkolenia</option>
              <option value="inne">Inne</option>
            </select>
          </div>

          <div class="mb-5">
            <label for="message" class="block text-sm font-medium text-gray-700 mb-1.5">Wiadomość *</label>
            <textarea id="message" name="message" rows="4" required
              class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-secondary focus:ring-2 focus:ring-secondary/20 outline-none transition-all text-sm resize-none"
              placeholder="Opisz swoje potrzeby..."></textarea>
          </div>

          <!-- RODO consent -->
          <div class="mb-6">
            <label class="flex items-start gap-3 cursor-pointer">
              <input type="checkbox" name="consent" required
                class="mt-1 w-4 h-4 rounded border-gray-300 text-secondary focus:ring-secondary/20" />
              <span class="text-xs text-gray-500 leading-relaxed">
                Wyrażam zgodę na przetwarzanie moich danych osobowych w celu odpowiedzi na przesłane zapytanie, zgodnie z
                <a href="/polityka-prywatnosci" class="text-secondary hover:underline">Polityką prywatności</a>. *
              </span>
            </label>
          </div>

          <!-- hCaptcha placeholder -->
          <div class="mb-6 p-4 bg-gray-50 rounded-xl border border-dashed border-gray-300 text-center text-sm text-gray-400">
            [ hCaptcha widget — zostanie dodany po konfiguracji ]
          </div>

          <button type="submit"
            class="w-full bg-secondary hover:bg-secondary-light text-white font-semibold py-4 px-8 rounded-xl transition-all hover:shadow-lg text-base">
            Wyślij wiadomość
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
