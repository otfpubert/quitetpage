---
import '../styles/global.css'
import { DEFAULT_THEME, type ThemeId } from '../config/themes';

interface Props {
  title?: string;
  theme?: ThemeId;
  bodyClass?: string;
}

const { title = 'StronaHR — Usługi kadrowo-płacowe', theme = DEFAULT_THEME, bodyClass = 'font-sans text-gray-800 antialiased' } = Astro.props;
---

<!doctype html>
<html lang="pl" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Profesjonalna obsługa kadrowo-płacowa dla Twojej firmy. Kadry, płace, HR, BHP — wszystko w jednym miejscu." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
